import pandas as pd

# Đọc dữ liệu từ file csv đã tạo
df = pd.read_csv("bang_du_lieu_giao_dich.csv")

# --- PHÂN TÍCH DỮ LIỆU & ĐÁNH GIÁ KẾT QUẢ ---

# 1. Thống kê tổng quan dữ liệu
tong_so_giao_dich = len(df)
tong_gia_tri = df["Amount"].sum()
gia_tri_trung_binh = df["Amount"].mean()

# 2. Phát hiện các giao dịch bất thường (Gian lận)
# Tiêu chí 1: Số tiền giao dịch vượt quá 3 lần giá trị trung bình thông thường
ngưỡng_bất_thường = 10000
giao_dich_gia_tri_cao = df[df["Amount"] > ngưỡng_bất_thường]

# Tiêu chí 2: Giao dịch có thông tin bị ẩn (Unknown)
giao_dich_nac_danh = df[(df["Merchant"] == "Unknown") | (df["Location"] == "Unknown")]

# 3. Xuất kết quả phân tích ra màn hình
print("=== KẾT QUẢ PHÂN TÍCH DỮ LIỆU TÀI CHÍNH ===")
print(f"- Tổng số lượng giao dịch: {tong_so_giao_dich}")
print(f"- Tổng giá trị dòng tiền: {tong_gia_tri} USD")
print(f"- Giá trị giao dịch trung bình: {gia_tri_trung_binh:.2f} USD")
print("\n=== ĐÁNH GIÁ KẾT QUẢ / PHÁT HIỆN GIAN LẬN ===")
print(f"1. Phát hiện {len(giao_dich_gia_tri_cao)} giao dịch có số tiền lớn bất thường:")
print(giao_dich_gia_tri_cao[["TransactionID", "AccountID", "Amount", "Location"]])

print(f"\n2. Phát hiện {len(giao_dich_nac_danh)} giao dịch rủi ro cao (Không rõ danh tính cửa hàng/vị trí):")
print(giao_dich_nac_danh[["TransactionID", "AccountID", "Amount", "Merchant", "Location"]])
